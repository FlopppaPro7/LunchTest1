--!nonstrict
--[[
	Game Flow Scanner — SINGLE-FILE BUILD (generated).

	Source of truth: plugin/src/*.luau. Regenerate with:
	    node plugin/build/bundle.mjs

	Install: paste this into a Script in Studio, right-click it and choose
	"Save as Local Plugin".
]]

-- Module loader (generated by build/bundle.mjs — do not edit).
local __modules = {}
local __cache = {}
local function __require(name)
	local cached = __cache[name]
	if cached ~= nil then return cached end
	local loader = __modules[name]
	if loader == nil then error("module not found: " .. name) end
	local value = loader()
	__cache[name] = value
	return value
end

__modules["Config"] = function()
--[[
	Config — constants shared across the scanner.

	Kept free of any Roblox side effects so it is trivially testable and safe to
	require from any module. Relationship types mirror schema/rbxflow.schema.md.
]]

local Config = {}

Config.FORMAT = "rbxflow"
Config.VERSION = 1
Config.SCANNER_NAME = "Game Flow Scanner"
Config.SCANNER_VERSION = "1.0.0"

-- How many instances to process between cooperative yields, so Studio stays
-- responsive on large places.
Config.YIELD_EVERY = 400

-- Standardized relationship types (extensible — new ones may be added later).
Config.REL = {
	REQUIRE = "require",
	FUNCTION_CALL = "function_call",
	FIRES_SERVER = "fires_server",
	FIRES_CLIENT = "fires_client",
	INVOKES_SERVER = "invokes_server",
	INVOKES_CLIENT = "invokes_client",
	SERVER_EVENT = "server_event",
	CLIENT_EVENT = "client_event",
	EVENT_CONNECTION = "event_connection",
	INSTANCE_REFERENCE = "instance_reference",
	ATTRIBUTE_READ = "attribute_read",
	ATTRIBUTE_WRITE = "attribute_write",
	PARENT_REFERENCE = "parent_reference",
	UNKNOWN = "unknown",
}

-- Script-like classes we read Source from.
Config.SCRIPT_CLASSES = {
	Script = true,
	LocalScript = true,
	ModuleScript = true,
}

-- Remote / bindable classes.
Config.REMOTE_CLASSES = {
	RemoteEvent = true,
	RemoteFunction = true,
	BindableEvent = true,
	BindableFunction = true,
}

-- Structural container classes worth showing as instance nodes.
Config.CONTAINER_CLASSES = {
	Folder = true,
	Model = true,
	Configuration = true,
	Actor = true,
}

-- Services scanned for scripts / remotes. Workspace is included but only its
-- scripts/remotes and their ancestors become nodes (not every Part).
Config.SCAN_SERVICES = {
	"ServerScriptService",
	"ServerStorage",
	"ReplicatedStorage",
	"ReplicatedFirst",
	"StarterPlayer",
	"StarterGui",
	"StarterPack",
	"Workspace",
	"Lighting",
	"SoundService",
	"Chat",
	"Teams",
}

-- Environment hints by top-level service.
Config.SERVER_SERVICES = {
	ServerScriptService = true,
	ServerStorage = true,
}
Config.CLIENT_SERVICES = {
	StarterPlayer = true,
	StarterGui = true,
	StarterPack = true,
	ReplicatedFirst = true,
	Players = true,
}
Config.SHARED_SERVICES = {
	ReplicatedStorage = true,
	Lighting = true,
	SoundService = true,
	Workspace = true,
	Chat = true,
	Teams = true,
}

-- Known service names PathResolver may treat as a root.
Config.KNOWN_SERVICES = {
	Workspace = true,
	Players = true,
	Lighting = true,
	ReplicatedStorage = true,
	ReplicatedFirst = true,
	ServerScriptService = true,
	ServerStorage = true,
	StarterGui = true,
	StarterPack = true,
	StarterPlayer = true,
	SoundService = true,
	Teams = true,
	Chat = true,
	TweenService = true,
	RunService = true,
	UserInputService = true,
	HttpService = true,
	CollectionService = true,
}

return Config

end

__modules["IdGenerator"] = function()
--[[
	IdGenerator — allocates stable, unique, non-name-based IDs.

	IDs are prefixed by kind purely for readability (module_001, remote_002…);
	the web app keys off className, not the prefix. Because traversal order is
	deterministic, the same place produces the same IDs across scans.
]]

local IdGenerator = {}
IdGenerator.__index = IdGenerator

local PREFIX = {
	Script = "script",
	LocalScript = "local",
	ModuleScript = "module",
	RemoteEvent = "remote",
	RemoteFunction = "remote",
	BindableEvent = "bindable",
	BindableFunction = "bindable",
	Event = "event",
	Function = "function",
}

function IdGenerator.new()
	return setmetatable({ counters = {} }, IdGenerator)
end

-- Returns a fresh id for a given kind/className.
function IdGenerator:next(kind: string): string
	local prefix = PREFIX[kind] or "instance"
	local n = (self.counters[prefix] or 0) + 1
	self.counters[prefix] = n
	return string.format("%s_%03d", prefix, n)
end

return IdGenerator

end

__modules["Classifier"] = function()
--[[
	Classifier — decides whether a script is server / client / shared.

	Combines the top-level service with the script class. Respects Script
	RunContext when available. A ModuleScript is classed by location (shared by
	default) rather than assumed server-only.
]]

local Config = __require("Config")

local Classifier = {}

-- Walks up to (but not including) `game`, returning the top-level service name.
local function topService(inst: Instance): string?
	local current = inst
	local parent = current.Parent
	while parent ~= nil and parent ~= game do
		current = parent
		parent = current.Parent
	end
	if parent == game then
		return current.Name
	end
	return nil
end

function Classifier.environment(inst: Instance): string
	local service = topService(inst)
	local class = inst.ClassName

	-- LocalScripts are always client.
	if class == "LocalScript" then
		return "client"
	end

	-- Honor an explicit RunContext on Scripts (Client/Server/Legacy).
	if class == "Script" then
		local ok, ctx = pcall(function()
			return (inst :: any).RunContext
		end)
		if ok and ctx ~= nil then
			local name = tostring(ctx)
			if string.find(name, "Client") then
				return "client"
			elseif string.find(name, "Server") then
				return "server"
			end
		end
	end

	if service ~= nil then
		if Config.SERVER_SERVICES[service] then
			return "server"
		elseif Config.CLIENT_SERVICES[service] then
			return "client"
		elseif Config.SHARED_SERVICES[service] then
			-- A Script in a shared container still runs on the server by default.
			if class == "Script" then
				return "server"
			end
			return "shared"
		end
	end

	-- Fallbacks by class.
	if class == "Script" then
		return "server"
	end
	return "shared"
end

return Classifier

end

__modules["PathResolver"] = function()
--[[
	PathResolver — best-effort static resolution of a Luau instance-path
	expression to an actual Instance.

	Handles the forms that appear in the vast majority of real code:
	  script.Parent.Foo
	  game.ReplicatedStorage.Modules.Foo
	  game:GetService("ReplicatedStorage").Remotes.Fire
	  ReplicatedStorage:WaitForChild("Remotes").Fire      (via a local alias)
	  Alias.Child["Name"]

	It resolves through a symbol table of `local` aliases the Analyzer builds.
	Anything it cannot resolve returns nil — callers must NOT fabricate an edge.
]]

local Config = __require("Config")

local PathResolver = {}

local function trim(s: string): string
	return (string.gsub(s, "^%s*(.-)%s*$", "%1"))
end

-- Collapse method-child accessors and bracket indexes into plain `.field`.
local function normalize(expr: string): string
	expr = trim(expr)
	expr = string.gsub(expr, "game%s*:%s*GetService%s*%(%s*['\"]([%w_]+)['\"]%s*%)", "%1")
	expr = string.gsub(expr, ":%s*WaitForChild%s*%(%s*['\"]([%w_]+)['\"]%s*%)", ".%1")
	expr = string.gsub(expr, ":%s*FindFirstChild%s*%(%s*['\"]([%w_]+)['\"]%s*%)", ".%1")
	expr = string.gsub(expr, "%[%s*['\"]([%w_]+)['\"]%s*%]", ".%1")
	expr = string.gsub(expr, "%s+", "")
	return expr
end

local function split(expr: string): { string }
	local tokens = {}
	for token in string.gmatch(expr, "[^%.]+") do
		table.insert(tokens, token)
	end
	return tokens
end

-- symbols: { [name]: Instance }
function PathResolver.resolve(expr: string, scriptInst: Instance, symbols: { [string]: Instance }): Instance?
	if expr == nil or expr == "" then
		return nil
	end
	local tokens = split(normalize(expr))
	if #tokens == 0 then
		return nil
	end

	local first = tokens[1]
	local current: Instance?

	if symbols[first] then
		current = symbols[first]
	elseif first == "script" then
		current = scriptInst
	elseif first == "game" then
		current = game
	elseif first == "workspace" or first == "Workspace" then
		current = workspace
	elseif Config.KNOWN_SERVICES[first] then
		local ok, svc = pcall(function()
			return game:GetService(first)
		end)
		current = ok and svc or nil
	else
		return nil
	end

	if current == nil then
		return nil
	end

	for i = 2, #tokens do
		local tk = tokens[i]
		if tk == "Parent" then
			current = current.Parent
		else
			local ok, child = pcall(function()
				return current:FindFirstChild(tk)
			end)
			current = ok and child or nil
		end
		if current == nil then
			return nil
		end
	end

	return current
end

PathResolver.normalize = normalize

return PathResolver

end

__modules["Scanner"] = function()
--[[
	Scanner — walks the DataModel and collects nodes. READ-ONLY: it never
	creates, modifies, or deletes anything in the user's game.

	It records scripts and remotes/bindables always, and adds the structural
	ancestors (Folders, Models, services) needed to connect them into a tree.
	Other instances are added on demand when a relationship resolves to them.
]]

local Config = __require("Config")

local Scanner = {}
Scanner.__index = Scanner

type Node = {
	id: string,
	kind: string,
	className: string,
	name: string,
	path: string,
	instance: Instance,
	parentId: string?,
	environment: string?,
	functions: { string }?,
	source: string?,
}

function Scanner.new(idGen)
	return setmetatable({
		idGen = idGen,
		order = {} :: { Instance },
		byInstance = {} :: { [Instance]: Node },
		counts = { scripts = 0, modules = 0, locals = 0, remotes = 0, instances = 0 },
	}, Scanner)
end

local function kindFor(class: string): string
	if Config.SCRIPT_CLASSES[class] or Config.REMOTE_CLASSES[class] then
		return class
	end
	return "Instance"
end

local function fullPath(inst: Instance): string
	local ok, path = pcall(function()
		return inst:GetFullName()
	end)
	if ok and typeof(path) == "string" then
		return path
	end
	return inst.Name
end

-- Adds an instance (and its ancestor chain) as a node; returns its id.
function Scanner:add(inst: Instance): string
	local existing = self.byInstance[inst]
	if existing then
		return existing.id
	end

	local class = inst.ClassName
	local kind = kindFor(class)
	local node: Node = {
		id = self.idGen:next(kind),
		kind = kind,
		className = class,
		name = inst.Name,
		path = fullPath(inst),
		instance = inst,
	}
	self.byInstance[inst] = node
	table.insert(self.order, inst)

	if Config.SCRIPT_CLASSES[class] then
		if class == "ModuleScript" then
			self.counts.modules += 1
		elseif class == "LocalScript" then
			self.counts.locals += 1
		else
			self.counts.scripts += 1
		end
	elseif Config.REMOTE_CLASSES[class] then
		self.counts.remotes += 1
	else
		self.counts.instances += 1
	end

	-- Ensure the ancestor chain exists so the tree is connected.
	local parent = inst.Parent
	if parent ~= nil and parent ~= game then
		self:add(parent)
	end

	return node.id
end

function Scanner:getId(inst: Instance): string?
	local n = self.byInstance[inst]
	return n and n.id or nil
end

function Scanner:getNode(inst: Instance): Node?
	return self.byInstance[inst]
end

-- Main pass: collect scripts and remotes from the scanned services.
function Scanner:scan(onProgress: ((processed: number) -> ())?)
	local processed = 0
	for _, serviceName in Config.SCAN_SERVICES do
		local ok, service = pcall(function()
			return game:GetService(serviceName)
		end)
		if not ok or service == nil then
			service = game:FindFirstChild(serviceName)
		end
		if service ~= nil then
			local ok2, descendants = pcall(function()
				return service:GetDescendants()
			end)
			if ok2 and descendants ~= nil then
				for _, desc in descendants do
					local class = desc.ClassName
					if Config.SCRIPT_CLASSES[class] or Config.REMOTE_CLASSES[class] then
						self:add(desc)
					end
					processed += 1
					if processed % Config.YIELD_EVERY == 0 then
						if onProgress then
							onProgress(processed)
						end
						task.wait()
					end
				end
			end
		end
	end

	-- Resolve parentId links now that the full set is known.
	for _, inst in self.order do
		local node = self.byInstance[inst]
		local parent = inst.Parent
		if parent ~= nil and self.byInstance[parent] then
			node.parentId = self.byInstance[parent].id
		else
			node.parentId = nil
		end
	end
end

-- Returns all collected nodes in insertion order.
function Scanner:nodes(): { Node }
	local list = {}
	for _, inst in self.order do
		table.insert(list, self.byInstance[inst])
	end
	return list
end

return Scanner

end

__modules["Analyzer"] = function()
--[[
	Analyzer — static source analysis.

	For every script it reads Source (read-only) and detects relationships by
	pattern-matching, tracking `local` aliases so the common resolvable forms
	are resolved to real Instances. It NEVER fabricates: anything it cannot
	resolve becomes a warning and/or is skipped, never a made-up edge.

	Detected: require, function_call (via module aliases), FireServer/Client,
	InvokeServer/Client, OnServerEvent/OnClientEvent (+ invoke handlers),
	BindableEvent connections, instance/parent references, attribute read/write.
]]

local Config = __require("Config")
local Classifier = __require("Classifier")
local PathResolver = __require("PathResolver")

local Analyzer = {}

local REMOTE_METHODS = {
	FireServer = true,
	FireClient = true,
	FireAllClients = true,
	InvokeServer = true,
	InvokeClient = true,
	Fire = true,
	Invoke = true,
	Connect = true,
	connect = true,
	Once = true,
	Wait = true,
	GetAttribute = true,
	SetAttribute = true,
	WaitForChild = true,
	FindFirstChild = true,
	GetService = true,
}

local function trim(s: string): string
	return (string.gsub(s, "^%s*(.-)%s*$", "%1"))
end

local function stripCR(s: string): string
	return (string.gsub(s, "\r$", ""))
end

local function splitLines(src: string): { string }
	local lines = {}
	local start = 1
	while true do
		local nl = string.find(src, "\n", start, true)
		if not nl then
			table.insert(lines, stripCR(string.sub(src, start)))
			break
		end
		table.insert(lines, stripCR(string.sub(src, start, nl - 1)))
		start = nl + 1
	end
	return lines
end

-- Extract the argument of the first require(...) on a line, honoring nested ().
local function requireArg(line: string): string?
	local rs = string.find(line, "require", 1, true)
	if not rs then
		return nil
	end
	local open = string.find(line, "(", rs, true)
	if not open then
		return nil
	end
	local depth = 1
	local i = open + 1
	while i <= #line do
		local c = string.sub(line, i, i)
		if c == "(" then
			depth += 1
		elseif c == ")" then
			depth -= 1
			if depth == 0 then
				return string.sub(line, open + 1, i - 1)
			end
		end
		i += 1
	end
	return nil
end

-- Analysis context bundles the mutable accumulators for one run.
local function newContext(scanner)
	return {
		scanner = scanner,
		relationships = {},
		warnings = {},
		relSeen = {},
		relCount = 0,
		warnCount = 0,
	}
end

local function addRel(ctx, fromId, toId, relType, line, snippet, confidence, meta)
	local extra = ""
	if meta then
		extra = tostring(meta.attribute or meta.method or "")
	end
	local key = string.format("%s|%s|%s|%s", fromId, toId, relType, extra)
	if ctx.relSeen[key] then
		return
	end
	ctx.relSeen[key] = true
	ctx.relCount += 1
	table.insert(ctx.relationships, {
		id = string.format("rel_%04d", ctx.relCount),
		from = fromId,
		to = toId,
		type = relType,
		line = line,
		snippet = snippet,
		confidence = confidence,
		meta = meta,
	})
end

local function addWarn(ctx, warnType, scriptId, line, message)
	ctx.warnCount += 1
	table.insert(ctx.warnings, {
		id = string.format("warn_%03d", ctx.warnCount),
		type = warnType,
		scriptId = scriptId,
		line = line,
		message = message,
	})
end

-- Resolve an expression to an instance id, optionally requiring a class filter.
local function resolveToId(ctx, expr, scriptInst, symbols, classFilter)
	local inst = PathResolver.resolve(expr, scriptInst, symbols)
	if inst == nil then
		return nil
	end
	if classFilter and not classFilter[inst.ClassName] then
		return nil
	end
	return ctx.scanner:add(inst)
end

local FIRE_MAP = {
	FireServer = { rel = Config.REL.FIRES_SERVER, dir = "client_to_server" },
	FireClient = { rel = Config.REL.FIRES_CLIENT, dir = "server_to_client" },
	FireAllClients = { rel = Config.REL.FIRES_CLIENT, dir = "server_to_client" },
	InvokeServer = { rel = Config.REL.INVOKES_SERVER, dir = "client_to_server" },
	InvokeClient = { rel = Config.REL.INVOKES_CLIENT, dir = "server_to_client" },
}

local HANDLER_MAP = {
	OnServerEvent = { rel = Config.REL.SERVER_EVENT, dir = "client_to_server" },
	OnClientEvent = { rel = Config.REL.CLIENT_EVENT, dir = "server_to_client" },
	OnServerInvoke = { rel = Config.REL.SERVER_EVENT, dir = "client_to_server", kind = "invoke" },
	OnClientInvoke = { rel = Config.REL.CLIENT_EVENT, dir = "server_to_client", kind = "invoke" },
}

local function collectFunctions(line: string, fnSet: { [string]: boolean })
	local n1 = string.match(line, "function%s+([%w_%.:]+)%s*%(")
	if n1 then
		local last = string.match(n1, "[%.:]([%w_]+)$") or n1
		fnSet[last] = true
	end
	local n2 = string.match(line, "local%s+function%s+([%w_]+)%s*%(")
	if n2 then
		fnSet[n2] = true
	end
	local n3 = string.match(line, "([%w_%.]+)%s*=%s*function%s*%(")
	if n3 then
		local last = string.match(n3, "[%.]([%w_]+)$") or n3
		fnSet[last] = true
	end
end

local REMOTE_CLASSES = Config.REMOTE_CLASSES
local ONLY_REMOTE_EVENT = { RemoteEvent = true }
local ONLY_REMOTE_FUNCTION = { RemoteFunction = true }
local ONLY_BINDABLE_EVENT = { BindableEvent = true }

local function analyzeScript(ctx, node, src, symbolsShared)
	local scriptInst = node.instance
	local fromId = node.id
	local symbols: { [string]: Instance } = {}
	local fnSet: { [string]: boolean } = {}
	local lines = splitLines(src)

	for lineNo, raw in lines do
		local line = raw
		local trimmed = trim(line)
		if trimmed == "" or string.sub(trimmed, 1, 2) == "--" then
			continue
		end
		local snippet = trimmed

		collectFunctions(line, fnSet)

		-- local NAME = RHS  ---------------------------------------------------
		local name, rhs = string.match(trimmed, "^local%s+([%w_]+)%s*=%s*(.+)$")
		if name and rhs then
			if string.find(rhs, "require", 1, true) then
				local arg = requireArg(line)
				if arg then
					local inst = PathResolver.resolve(arg, scriptInst, symbols)
					if inst ~= nil then
						symbols[name] = inst
						local toId = ctx.scanner:add(inst)
						local conf = (inst.ClassName == "ModuleScript") and "high" or "medium"
						addRel(ctx, fromId, toId, Config.REL.REQUIRE, lineNo, snippet, conf, nil)
					else
						addWarn(ctx, "unresolved_require", fromId, lineNo,
							"Could not statically resolve require() target: " .. trim(arg))
					end
				else
					addWarn(ctx, "dynamic_reference", fromId, lineNo,
						"Dynamic require() could not be parsed.")
				end
			else
				local inst = PathResolver.resolve(rhs, scriptInst, symbols)
				if inst ~= nil then
					symbols[name] = inst
					-- Only emit a reference edge for structural instances; remotes
					-- get their edge from usage (FireServer/etc.), not the alias,
					-- and bare service handles (game:GetService) are just noise.
					local isService = inst.Parent == game
					if not isService
						and not Config.SCRIPT_CLASSES[inst.ClassName]
						and not REMOTE_CLASSES[inst.ClassName]
					then
						local toId = ctx.scanner:add(inst)
						local relType = Config.REL.INSTANCE_REFERENCE
						if PathResolver.normalize(rhs) == "script.Parent" then
							relType = Config.REL.PARENT_REFERENCE
						end
						addRel(ctx, fromId, toId, relType, lineNo, snippet, "medium", nil)
					end
				end
			end
		end

		-- Fire / Invoke calls  -----------------------------------------------
		for recv, method in string.gmatch(line, "([%w_%.]+)%s*:%s*([%w_]+)%s*%(") do
			local fire = FIRE_MAP[method]
			if fire then
				local filter = (method == "InvokeServer" or method == "InvokeClient")
						and ONLY_REMOTE_FUNCTION
					or nil
				local toId = resolveToId(ctx, recv, scriptInst, symbols, filter)
				if toId == nil then
					-- Try without a hard class filter for lenient RemoteEvents.
					toId = resolveToId(ctx, recv, scriptInst, symbols, nil)
					if toId ~= nil then
						-- Guard: only keep if it actually resolved to a remote.
						local inst = PathResolver.resolve(recv, scriptInst, symbols)
						if inst == nil or not REMOTE_CLASSES[inst.ClassName] then
							toId = nil
						end
					end
				end
				if toId ~= nil then
					addRel(ctx, fromId, toId, fire.rel, lineNo, snippet, "high", { direction = fire.dir })
				else
					addWarn(ctx, "unknown_relationship", fromId, lineNo,
						string.format("Detected :%s() but could not resolve the remote (%s).", method, recv))
				end
			elseif method == "GetAttribute" or method == "SetAttribute" then
				local attr = string.match(line, method .. "%s*%(%s*['\"]([%w_]+)['\"]")
				local toId = resolveToId(ctx, recv, scriptInst, symbols, nil)
				if toId ~= nil then
					local relType = (method == "GetAttribute") and Config.REL.ATTRIBUTE_READ
						or Config.REL.ATTRIBUTE_WRITE
					addRel(ctx, fromId, toId, relType, lineNo, snippet, attr and "high" or "medium",
						attr and { attribute = attr } or nil)
				end
			elseif ctx.scanner ~= nil then
				-- function_call via a module alias.
				local aliasInst = symbols[recv]
				if aliasInst ~= nil and aliasInst.ClassName == "ModuleScript" and not REMOTE_METHODS[method] then
					local toId = ctx.scanner:add(aliasInst)
					addRel(ctx, fromId, toId, Config.REL.FUNCTION_CALL, lineNo, snippet, "medium",
						{ method = method })
				end
			end
		end

		-- function_call via a module alias using dot syntax (Module.Fn(...)).
		for recv, method in string.gmatch(line, "([%w_]+)%.([%w_]+)%s*%(") do
			local aliasInst = symbols[recv]
			if aliasInst ~= nil and aliasInst.ClassName == "ModuleScript" and not REMOTE_METHODS[method] then
				local toId = ctx.scanner:add(aliasInst)
				addRel(ctx, fromId, toId, Config.REL.FUNCTION_CALL, lineNo, snippet, "medium",
					{ method = method })
			end
		end

		-- Event handlers (.OnServerEvent / .OnClientEvent / invoke handlers) --
		for recv, handler in string.gmatch(line, "([%w_%.]+)%.(On%w+)") do
			local map = HANDLER_MAP[handler]
			if map then
				local filter = (handler == "OnServerInvoke" or handler == "OnClientInvoke")
						and ONLY_REMOTE_FUNCTION
					or ONLY_REMOTE_EVENT
				local toId = resolveToId(ctx, recv, scriptInst, symbols, filter)
				if toId == nil then
					toId = resolveToId(ctx, recv, scriptInst, symbols, nil)
					local inst = PathResolver.resolve(recv, scriptInst, symbols)
					if inst == nil or not REMOTE_CLASSES[inst.ClassName] then
						toId = nil
					end
				end
				if toId ~= nil then
					local meta = { direction = map.dir }
					if map.kind then
						meta.kind = map.kind
					end
					addRel(ctx, fromId, toId, map.rel, lineNo, snippet, "high", meta)
				end
			end
		end

		-- BindableEvent connection (X.Event:Connect).
		local bindRecv = string.match(line, "([%w_%.]+)%.Event%s*:%s*Connect")
		if bindRecv then
			local toId = resolveToId(ctx, bindRecv, scriptInst, symbols, ONLY_BINDABLE_EVENT)
			if toId ~= nil then
				addRel(ctx, fromId, toId, Config.REL.EVENT_CONNECTION, lineNo, snippet, "high", nil)
			end
		end
	end

	-- Materialize the function-name list for the node.
	local fns = {}
	for fnName in fnSet do
		table.insert(fns, fnName)
	end
	table.sort(fns)
	node.functions = fns
	symbolsShared[node.id] = symbols
end

-- options: { includeSource: boolean }
function Analyzer.run(scanner, options, onProgress)
	local ctx = newContext(scanner)
	local symbolsShared = {}
	local includeSource = options ~= nil and options.includeSource == true

	local nodes = scanner:nodes()
	local processed = 0
	for _, node in nodes do
		if Config.SCRIPT_CLASSES[node.className] then
			node.environment = Classifier.environment(node.instance)

			local ok, src = pcall(function()
				return (node.instance :: any).Source
			end)
			if ok and typeof(src) == "string" then
				if includeSource then
					node.source = src
				end
				local ok2, err = pcall(function()
					analyzeScript(ctx, node, src, symbolsShared)
				end)
				if not ok2 then
					addWarn(ctx, "parse_issue", node.id, nil,
						"Analysis failed for this script: " .. tostring(err))
				end
			else
				addWarn(ctx, "source_unavailable", node.id, nil,
					"Could not read Source (grant script-injection permission to analyze this script).")
			end
		end

		processed += 1
		if processed % Config.YIELD_EVERY == 0 then
			if onProgress then
				onProgress(processed, #nodes)
			end
			task.wait()
		end
	end

	return ctx.relationships, ctx.warnings
end

return Analyzer

end

__modules["Exporter"] = function()
--[[
	Exporter — assembles the normalized scan into the rbxflow document and
	encodes it as JSON. It performs no I/O beyond JSONEncode; the UI decides
	what to do with the resulting string. Nothing is uploaded anywhere.

	Schema: schema/rbxflow.schema.md (format "rbxflow", version 1).
]]

local HttpService = game:GetService("HttpService")

local Config = __require("Config")

local Exporter = {}

local function attributesOf(inst: Instance): { [string]: any }?
	local ok, attrs = pcall(function()
		return inst:GetAttributes()
	end)
	if ok and typeof(attrs) == "table" and next(attrs) ~= nil then
		return attrs
	end
	return nil
end

local function baseDict(node)
	local d: { [string]: any } = {
		id = node.id,
		name = node.name,
		className = node.className,
		path = node.path,
	}
	if node.parentId ~= nil then
		d.parentId = node.parentId
	end
	local attrs = attributesOf(node.instance)
	if attrs then
		d.attributes = attrs
	end
	return d
end

-- Builds the full rbxflow table from a completed scan + analysis.
function Exporter.build(scanner, relationships, warnings): { [string]: any }
	local instances = {}
	local scripts = {}
	local remotes = {}

	for _, node in scanner:nodes() do
		local class = node.className
		if Config.SCRIPT_CLASSES[class] then
			local d = baseDict(node)
			d.environment = node.environment or "shared"
			d.functions = node.functions or {}
			if node.source ~= nil then
				d.source = node.source
			end
			table.insert(scripts, d)
		elseif Config.REMOTE_CLASSES[class] then
			table.insert(remotes, baseDict(node))
		else
			table.insert(instances, baseDict(node))
		end
	end

	local placeName = game.Name
	if placeName == nil or placeName == "" then
		placeName = "Roblox Place"
	end

	local generatedAt = "unknown"
	pcall(function()
		generatedAt = DateTime.now():ToIsoDate()
	end)

	return {
		format = Config.FORMAT,
		version = Config.VERSION,
		project = {
			name = placeName,
			generatedAt = generatedAt,
			placeId = tostring(game.PlaceId),
			gameId = tostring(game.GameId),
			scanner = { name = Config.SCANNER_NAME, version = Config.SCANNER_VERSION },
		},
		instances = instances,
		scripts = scripts,
		remotes = remotes,
		events = {},
		functions = {},
		relationships = relationships,
		warnings = warnings,
		-- Reserved for a future runtime-tracing version; empty in the MVP.
		runtime = { executions = {}, events = {}, timings = {} },
	}
end

-- Encodes a built document as a JSON string. Returns (json, err).
function Exporter.encode(doc): (string?, string?)
	local ok, result = pcall(function()
		return HttpService:JSONEncode(doc)
	end)
	if ok then
		return result, nil
	end
	return nil, tostring(result)
end

return Exporter

end

__modules["UI"] = function()
--[[
	UI — builds the dock-widget interface. Kept entirely separate from scanning
	and exporting: it exposes callbacks (onScan, onExport) and setters
	(setStatus, setCounts, showExport) and knows nothing about the DataModel.

	Studio plugins cannot write files to disk, so "Export" shows the JSON in a
	read-only, select-all textbox to copy into a .json file.
]]

local UI = {}
UI.__index = UI

-- Palette (mirrors the RBXFlow web app's dark dev-tool look).
local C = {
	bg = Color3.fromRGB(13, 17, 23),
	panel = Color3.fromRGB(22, 29, 38),
	panel2 = Color3.fromRGB(28, 37, 48),
	border = Color3.fromRGB(35, 44, 56),
	text = Color3.fromRGB(230, 237, 243),
	sub = Color3.fromRGB(125, 136, 150),
	accent = Color3.fromRGB(76, 154, 255),
	accentText = Color3.fromRGB(7, 16, 25),
	ok = Color3.fromRGB(87, 201, 139),
	warn = Color3.fromRGB(242, 184, 75),
}

local function make(className: string, props: { [string]: any }, children: { Instance }?): Instance
	local inst = Instance.new(className)
	for k, v in props do
		(inst :: any)[k] = v
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	return inst
end

local function statRow(labelText: string): (Frame, TextLabel)
	local value = make("TextLabel", {
		Name = "Value",
		Text = "0",
		Font = Enum.Font.Code,
		TextSize = 14,
		TextColor3 = C.text,
		TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundTransparency = 1,
		Size = UDim2.new(0.4, 0, 1, 0),
		Position = UDim2.new(0.6, 0, 0, 0),
	}) :: TextLabel

	local row = make("Frame", {
		Name = "Row",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 22),
	}, {
		make("TextLabel", {
			Text = labelText,
			Font = Enum.Font.Gotham,
			TextSize = 13,
			TextColor3 = C.sub,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
			Size = UDim2.new(0.6, 0, 1, 0),
		}),
		value,
	}) :: Frame

	return row, value
end

local function button(text: string, primary: boolean): TextButton
	return make("TextButton", {
		Text = text,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		AutoButtonColor = true,
		TextColor3 = primary and C.accentText or C.text,
		BackgroundColor3 = primary and C.accent or C.panel2,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 34),
	}, {
		make("UICorner", { CornerRadius = UDim.new(0, 6) }),
	}) :: TextButton
end

function UI.new(parent: Instance, callbacks: { onScan: () -> (), onExport: () -> () })
	local self = setmetatable({ includeSource = false }, UI)

	local root = make("Frame", {
		Name = "GameFlowScanner",
		BackgroundColor3 = C.bg,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
	}, {
		make("UIPadding", {
			PaddingTop = UDim.new(0, 12),
			PaddingBottom = UDim.new(0, 12),
			PaddingLeft = UDim.new(0, 12),
			PaddingRight = UDim.new(0, 12),
		}),
		make("UIListLayout", {
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	root.Parent = parent

	local order = 0
	local function add(child: Instance)
		order += 1
		child:SetAttribute("LayoutOrder", order);
		(child :: any).LayoutOrder = order
		child.Parent = root
	end

	add(make("TextLabel", {
		Text = "GAME FLOW SCANNER",
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		TextColor3 = C.text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 20),
	}))

	local scanBtn = button("Scan Project", true)
	scanBtn.Activated:Connect(function()
		callbacks.onScan()
	end)
	add(scanBtn)

	local status = make("TextLabel", {
		Text = "Status: Ready",
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = C.sub,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 32),
	}) :: TextLabel
	add(status)
	self.status = status

	-- Counts panel.
	local counts = make("Frame", {
		BackgroundColor3 = C.panel,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 156),
	}, {
		make("UICorner", { CornerRadius = UDim.new(0, 8) }),
		make("UIPadding", {
			PaddingTop = UDim.new(0, 10),
			PaddingBottom = UDim.new(0, 10),
			PaddingLeft = UDim.new(0, 12),
			PaddingRight = UDim.new(0, 12),
		}),
		make("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	self.values = {}
	local labels = {
		{ "Scripts", "scripts" },
		{ "Modules", "modules" },
		{ "LocalScripts", "locals" },
		{ "Remotes", "remotes" },
		{ "Relationships", "relationships" },
		{ "Warnings", "warnings" },
	}
	for i, pair in labels do
		local row, value = statRow(pair[1]);
		(row :: any).LayoutOrder = i
		row.Parent = counts
		self.values[pair[2]] = value
	end
	add(counts)

	-- Include Source Code toggle.
	local checkBox = make("TextButton", {
		Text = "",
		AutoButtonColor = true,
		BackgroundColor3 = C.panel2,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 20, 0, 20),
	}, {
		make("UICorner", { CornerRadius = UDim.new(0, 4) }),
	}) :: TextButton
	local check = make("TextLabel", {
		Text = "",
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextColor3 = C.accent,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
	}) :: TextLabel
	check.Parent = checkBox
	checkBox.Activated:Connect(function()
		self.includeSource = not self.includeSource
		check.Text = self.includeSource and "✓" or ""
	end)

	local toggleRow = make("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 22),
	}, {
		make("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 8),
		}),
		checkBox,
		make("TextLabel", {
			Text = "Include Source Code",
			Font = Enum.Font.Gotham,
			TextSize = 13,
			TextColor3 = C.text,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -28, 1, 0),
		}),
	})
	add(toggleRow)

	local exportBtn = button("Export JSON", false)
	exportBtn.Activated:Connect(function()
		callbacks.onExport()
	end)
	add(exportBtn)

	-- Export output (read-only textbox for copy).
	local hint = make("TextLabel", {
		Text = "Select all (Ctrl/Cmd+A) and copy, then paste into a .json file.",
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextColor3 = C.sub,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Visible = false,
		Size = UDim2.new(1, 0, 0, 28),
	}) :: TextLabel
	add(hint)
	self.hint = hint

	local outputBox = make("TextBox", {
		Text = "",
		Font = Enum.Font.Code,
		TextSize = 11,
		TextColor3 = C.text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		MultiLine = true,
		ClearTextOnFocus = false,
		TextEditable = true,
		BackgroundColor3 = Color3.fromRGB(10, 14, 19),
		BorderColor3 = C.border,
		Visible = false,
		Size = UDim2.new(1, 0, 0, 200),
	}, {
		make("UICorner", { CornerRadius = UDim.new(0, 6) }),
		make("UIPadding", {
			PaddingTop = UDim.new(0, 8),
			PaddingBottom = UDim.new(0, 8),
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		}),
	}) :: TextBox
	add(outputBox)
	self.outputBox = outputBox

	local selectBtn = button("Select All", false)
	selectBtn.Visible = false
	selectBtn.Activated:Connect(function()
		outputBox:CaptureFocus()
		pcall(function()
			outputBox.SelectionStart = 1
			outputBox.CursorPosition = #outputBox.Text + 1
		end)
	end)
	add(selectBtn)
	self.selectBtn = selectBtn

	return self
end

function UI:setStatus(text: string)
	self.status.Text = "Status: " .. text
end

function UI:setCounts(counts: { [string]: number })
	for key, label in self.values do
		label.Text = tostring(counts[key] or 0)
	end
end

function UI:getIncludeSource(): boolean
	return self.includeSource
end

function UI:showExport(json: string)
	self.outputBox.Text = json
	self.outputBox.Visible = true
	self.selectBtn.Visible = true
	self.hint.Visible = true
end

return UI

end

-- ===== Main =====
--[[
	Game Flow Scanner — plugin entry point.

	Creates the toolbar button and dock widget, then wires the UI to the
	Scanner / Analyzer / Exporter modules. This script is the ONLY place that
	touches plugin APIs; all analysis lives in the sibling ModuleScripts.

	Read-only: nothing in the user's game is created or modified.
]]

local IdGenerator = __require("IdGenerator")
local Scanner = __require("Scanner")
local Analyzer = __require("Analyzer")
local Exporter = __require("Exporter")
local UI = __require("UI")

local toolbar = plugin:CreateToolbar("Game Flow Scanner")
local button = toolbar:CreateButton(
	"GameFlowScannerToggle",
	"Open the Game Flow Scanner",
	"rbxasset://textures/StudioSharedUI/menuAnalytics.png",
	"Flow Scanner"
)
button.ClickableWhenViewportHidden = true

local widgetInfo = DockWidgetPluginGuiInfo.new(
	Enum.InitialDockState.Right,
	false, -- initially disabled
	false,
	340, -- floating width
	560, -- floating height
	300, -- min width
	400 -- min height
)
local widget = plugin:CreateDockWidgetPluginGui("GameFlowScanner", widgetInfo)
widget.Title = "Game Flow Scanner"
widget.Name = "GameFlowScanner"

-- Latest scan result, held for export.
local state: { scanner: any, relationships: any, warnings: any }? = nil
local scanning = false

local ui
ui = UI.new(widget, {
	onScan = function()
		if scanning then
			return
		end
		scanning = true
		task.spawn(function()
			local ok, err = pcall(function()
				ui:setStatus("Scanning DataModel…")

				local idGen = IdGenerator.new()
				local scanner = Scanner.new(idGen)
				scanner:scan(function(processed)
					ui:setStatus(string.format("Scanning… %d instances", processed))
					ui:setCounts({
						scripts = scanner.counts.scripts,
						modules = scanner.counts.modules,
						locals = scanner.counts.locals,
						remotes = scanner.counts.remotes,
					})
				end)

				ui:setStatus("Analyzing source…")
				local relationships, warnings = Analyzer.run(scanner, {
					includeSource = ui:getIncludeSource(),
				}, function(done, total)
					ui:setStatus(string.format("Analyzing… %d / %d scripts", done, total))
				end)

				state = { scanner = scanner, relationships = relationships, warnings = warnings }
				ui:setCounts({
					scripts = scanner.counts.scripts,
					modules = scanner.counts.modules,
					locals = scanner.counts.locals,
					remotes = scanner.counts.remotes,
					relationships = #relationships,
					warnings = #warnings,
				})
				ui:setStatus(string.format(
					"Scan complete — %d relationships, %d warnings.",
					#relationships,
					#warnings
				))
			end)
			if not ok then
				ui:setStatus("Scan failed: " .. tostring(err))
			end
			scanning = false
		end)
	end,

	onExport = function()
		if state == nil then
			ui:setStatus("Run a scan first.")
			return
		end
		local doc = Exporter.build(state.scanner, state.relationships, state.warnings)
		local json, err = Exporter.encode(doc)
		if json ~= nil then
			ui:showExport(json)
			ui:setStatus(string.format("Exported %d characters — copy from the box below.", #json))
		else
			ui:setStatus("Export failed: " .. tostring(err))
		end
	end,
})

button.Click:Connect(function()
	widget.Enabled = not widget.Enabled
	button:SetActive(widget.Enabled)
end)

widget:GetPropertyChangedSignal("Enabled"):Connect(function()
	button:SetActive(widget.Enabled)
end)

